    "bin"
  ],
  "bin": {
    "tally-mcp": "./bin/tally-mcp.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@india-stack/core": "*",
    "@modelcontextprotocol/sdk": "^1.12.0",
