{
  "name": "@india-stack/connector-tally",
  "version": "0.1.0",
  "description": "MCP connector for TallyPrime: vouchers, ledgers, reports over the local XML gateway.",
  "keywords": ["mcp", "model-context-protocol", "tally", "tallyprime", "accounting", "india", "ai-agents"],
  "license": "Apache-2.0",
  "type": "module",
